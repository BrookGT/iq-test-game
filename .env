# API backend
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:5000

# Public site URL
NEXT_PUBLIC_APP_WEB_URL=http://localhost:3000

# API path prefix (do not change)
NEXT_PUBLIC_END_POINT=/api/

NEXT_PUBLIC_DEFAULT_COUNTRY=in
NEXT_PUBLIC_LANGUAGE_CONFIGURATION=['en','hi','ar','es']
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Use server mode for Docker builds; set false for static export hosting
NEXT_PUBLIC_SEO=true

NEXT_PUBLIC_INSPECT_ELEMENT=false
NEXT_PUBLIC_META_TITLE=IQ Test Game — Play, Learn, and Compete
NEXT_PUBLIC_META_DESCRIPTION=Challenge your knowledge with daily quizzes, battles, contests, and self-learning modes on IQ Test Game.
NEXT_PUBLIC_KEYWORDS=IQ Test Game,Quiz,Trivia,Learning,Brain Games

NEXT_PUBLIC_DATA_AD_CLIENT=
NEXT_PUBLIC_DATA_AD_SLOT=
NEXT_PUBLIC_DEMO=false
NEXT_PUBLIC_BATTLE_EMOJI_TEXT_MILI_SECONDS=4000
